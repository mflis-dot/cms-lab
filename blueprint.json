{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "steps": [
    { "step": "setSiteLanguage", "language": "pl_PL" },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Strona główna' --post_name='home' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Usługi' --post_name='uslugi' --post_status=publish"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $parent = get_page_by_path('uslugi', OBJECT, 'page'); wp_insert_post(['post_type'=>'page','post_title'=>'Naprawa komputerów i laptopów','post_name'=>'naprawa-komputerow-i-laptopow','post_parent'=>$parent->ID,'post_status'=>'publish']); ?>"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $parent = get_page_by_path('uslugi', OBJECT, 'page'); wp_insert_post(['post_type'=>'page','post_title'=>'Naprawa drukarek','post_name'=>'naprawa-drukarek','post_parent'=>$parent->ID,'post_status'=>'publish']); ?>"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $parent = get_page_by_path('uslugi', OBJECT, 'page'); wp_insert_post(['post_type'=>'page','post_title'=>'Naprawa konsol','post_name'=>'naprawa-konsol','post_parent'=>$parent->ID,'post_status'=>'publish']); ?>"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Cennik' --post_name='cennik' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='O firmie' --post_name='o-nas' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='FAQ' --post_name='faq' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Kontakt' --post_name='kontakt' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Polityka prywatności' --post_name='polityka-prywatnosci' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp option update show_on_front page"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $home = get_page_by_path('home', OBJECT, 'page'); update_option('show_on_front', 'page'); update_option('page_on_front', $home->ID);"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_delete_post(1, true);"
    }
  ]
}
